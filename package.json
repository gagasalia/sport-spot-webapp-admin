{
  "name": "sportify-admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm:build:css:watch\" \"npm:serve\"",
    "serve": "ng serve --port 4201",
    "dev": "npm run build:css:watch & npm start",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint \"src/**/*.{ts,html}\" --fix",
    "lint:check": "eslint \"src/**/*.{ts,html}\"",
    "build:css": "tailwindcss -i ./src/input.css -o ./src/output.css",
    "build:css:watch": "tailwindcss -i ./src/input.css -o ./src/output.css --watch"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/google-maps": "^21.1.5",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@maskito/angular": "^3.11.1",
    "@maskito/core": "^3.11.1",
    "@maskito/kit": "^3.11.1",
    "@maskito/phone": "^3.11.1",
    "@tailwindcss/cli": "^4.1.15",
    "libphonenumber-js": "^1.12.31",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.15",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.5",
    "@angular/cli": "^20.3.5",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "@types/uuid": "^10.0.0",
    "angular-eslint": "^20.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.61.0"
  }
}
